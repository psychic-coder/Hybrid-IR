# HybridIR configuration. Copy to .env to override; every variable also has a default in
# docker-compose.yml, so this file is optional. Changing anything marked [reseed] requires
# `make reseed` (FORCE_RESEED=1) because it changes built artifacts.

# ---------------------------------------------------------------- dataset
# scifact (5,183 docs, 300 test queries) | nfcorpus (3,633 docs, 323) | fiqa (57,638 docs, 648)  [reseed]
DATASET=scifact

# Mirror to download BEIR zips from (<url>/<dataset>.zip).
BEIR_BASE_URL=https://public.ukp.informatik.tu-darmstadt.de/thakur/BEIR/datasets

# Set by docker-compose to container paths/addresses; only relevant when running the backend
# outside Docker (e.g. `uvicorn app.main:app` on the host):
#   DATA_DIR=/data  RESULTS_DIR=/results  HF_HOME=/hf_cache
#   QDRANT_URL=http://qdrant:6333  REDIS_URL=redis://redis:6379/0
#   HF_HUB_OFFLINE=1 (api) / 0 (seed)

# ---------------------------------------------------------------- ports (host side)
API_PORT=8000
WEB_PORT=3000
QDRANT_PORT=6333

# ---------------------------------------------------------------- frontend
# URL the *browser* uses to reach the API. Baked into the JS bundle at build time:
# change it, then `docker compose build web`.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Link shown on the About page.
NEXT_PUBLIC_README_URL=https://github.com/your-org/hybridir#readme
# Origins allowed by the API's CORS policy (comma separated). Must include the web origin.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- models  [reseed]
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Documents per embedding batch (memory vs throughput). 16-64 is fine on 8 GB.
EMBED_BATCH_SIZE=32
# Pairs per cross-encoder batch.
RERANK_BATCH_SIZE=32
# Max tokens of (query, passage) seen by the cross-encoder. Higher = slower, sees more text.
RERANK_MAX_LENGTH=256
# torch intra-op threads; 0 = torch default (all cores).
TORCH_THREADS=0

# ---------------------------------------------------------------- tokenizer / index  [reseed]
USE_STEMMER=true
USE_STOPWORDS=true
# Tokens shorter than this are dropped.
MIN_TOKEN_LEN=1
# Whitespace-token window per chunk; 0 disables chunking. Docs shorter than this are not split.
CHUNK_SIZE=256
CHUNK_OVERLAP=32
# Postings per skip-pointer block (smaller = more skipping, larger header).
SKIP_INTERVAL=64

# ---------------------------------------------------------------- retrieval defaults (per-request overridable)
# qdrant | custom (from-scratch NumPy HNSW; builds slowly on large corpora)  [reseed]
DENSE_BACKEND=qdrant
# BM25 saturation (0-5) and length normalization (0-1). The index stores exact WAND bounds
# for these values; other values use a Pareto-front bound (same results, slightly more work).
BM25_K1=1.2
BM25_B=0.75
# Added score per matched "quoted phrase" = PHRASE_BOOST * sum(idf of phrase terms).
PHRASE_BOOST=1.0
# HNSW graph degree and build breadth  [reseed]
HNSW_M=16
HNSW_EF_CONSTRUCT=100
# HNSW query breadth (recall vs latency).
HNSW_EF=64
RRF_K=60
# Dense weight in weighted fusion; 1-alpha goes to BM25.
FUSION_ALPHA=0.5
# minmax | zscore
FUSION_NORM=minmax
# Candidates each retriever contributes to fusion.
CANDIDATE_DEPTH=100
# Fused candidates scored by the cross-encoder.
RERANK_TOP_K=50
# Depth of the ranking kept for evaluation (metrics @100 need 100).
EVAL_DEPTH=100

# ---------------------------------------------------------------- cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------- api
# Client timeouts for the vector store and Redis (Redis failures fail open).
QDRANT_TIMEOUT_SECONDS=10
REDIS_TIMEOUT_SECONDS=1
# Enables POST /admin/eval when non-empty (send it as the X-Admin-Token header). Never commit it.
ADMIN_TOKEN=
SEARCH_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# ---------------------------------------------------------------- seed / evaluation
# 1 = rebuild index, embeddings, collection and results even if the marker says they exist.
FORCE_RESEED=false
# How long the seed waits for Qdrant/Redis before failing.
SEED_WAIT_TIMEOUT_SECONDS=180
# 0 = all test queries; N = first N (sorted by id), for quick runs.
EVAL_MAX_QUERIES=0
# Queries and worker threads for the concurrent QPS measurement.
EVAL_QPS_QUERIES=100
EVAL_QPS_THREADS=4
# Second pass with the query-embedding cache warm.
EVAL_WARM_PASS=true
# Run every ablation grid during the first seed (adds several minutes on scifact).
ABLATIONS_ON_SEED=true
ABLATION_MAX_QUERIES=0
# Queries per rerank depth used to time the cross-encoder in the rerank ablation.
ABLATION_LATENCY_SAMPLE=50
BOOTSTRAP_RESAMPLES=10000
RANDOM_SEED=42
# Test queries exported to results/queries.json for k6.
K6_QUERY_SAMPLE=200

# ---------------------------------------------------------------- load test (k6)
K6_SCRIPT=k6_search.js
K6_BM25_RATE=20
K6_DENSE_RATE=10
K6_HYBRID_RATE=8
K6_RERANK_RATE=2
K6_MIXED_RATE=5
K6_STAGE_SECONDS=30
K6_P95_MS=2000
K6_RERANK_P95_MS=8000
